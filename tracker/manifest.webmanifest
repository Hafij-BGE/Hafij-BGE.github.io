{
  "name": "Research Log",
  "short_name": "Research Log",
  "description": "Lab notebook, research progress and academic record — synced between phone and web.",
  "id": "/tracker/",
  "start_url": "/tracker/",
  "scope": "/tracker/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F3F5F4",
  "theme_color": "#18212B",
  "categories": ["productivity", "education"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New experiment", "url": "/tracker/#/lab/experiment/new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New task", "url": "/tracker/#/research/task/new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
